#!/bin/bash

die() {
    echo "Error: $1" >&2
    exit 1
}

KUBECONFIG=${KUBECONFIG:-"/etc/kubernetes/admin.conf"}
NODES=1

# Directory with required tools 
TOOLS_DIR="${TOOLS_DIR:-}"
if [[ -n "$TOOLS_DIR" ]]; then
  [[ -d "$TOOLS_DIR" ]] || die "TOOLS_DIR '${TOOLS_DIR}' is not a directory"
  TOOLS_DIR="$(cd "$TOOLS_DIR" && pwd)"
  export PATH="${TOOLS_DIR}:${PATH}"
  [[ -x "${TOOLS_DIR}/kubectl" ]] \
    || die "kubectl not found in TOOLS_DIR (${TOOLS_DIR}); expected an executable at ${TOOLS_DIR}/kubectl"
fi

# Note that you need to point kubeconfig correctly, otherwise kubectl cannot list sever version
K8S_VERSION="$(kubectl version | grep 'Server Version:' -m1 | cut -d":" -f2 | tr -d " ")"
TEST_RUN_DIR=$(pwd)
STORAGE_CLASS=${STORAGE_CLASS:-$(pwd)/quobyte-csi/example/StorageClass.yaml}
SNAPSHOT_CLASS=${SNAPSHOT_CLASS:-''}
CSI_PROVISIONER_NAME=${CSI_PROVISIONER_NAME:-'csi.quobyte.com'}
E2E_RUN_DIR="${ARTIFACTS_DIR:-$(mktemp -d -t quobyte-csi-e2e-XXXXXX)}"
E2E_TEST_CONFIG_PATH="${E2E_RUN_DIR}/quobyte-csi-driver.yaml"
TESTS_LOGS_PATH="${E2E_RUN_DIR}/csi-driver-e2e.log"

# Cache directory for the prebuilt kubernetes-test tarball (e2e.test + a matching
# ginkgo binary), keyed by K8S_VERSION so switching kind/cluster versions doesn't
# require deleting anything by hand. Unused when TOOLS_DIR is set.
KUBE_TEST_TOOLS_DIR="${KUBE_TEST_TOOLS_DIR:-/tmp/kube-test-tools}"

if [[ -n "$TOOLS_DIR" ]]; then
  # Tools are provided pre-built; verify them instead of downloading anything.
  E2E_TEST_BIN="${TOOLS_DIR}/e2e.test"
  GINKGO_BIN="${TOOLS_DIR}/ginkgo"
  [[ -x "$E2E_TEST_BIN" ]] \
    || die "e2e.test not found in TOOLS_DIR (${TOOLS_DIR}); expected an executable at ${E2E_TEST_BIN}"
  [[ -x "$GINKGO_BIN" ]] \
    || die "ginkgo not found in TOOLS_DIR (${TOOLS_DIR}); expected an executable at ${GINKGO_BIN}"
else
  # Fetch the official prebuilt e2e.test + ginkgo binaries for this exact cluster
  # version instead of cloning kubernetes/kubernetes and building them from source
  # (https://dl.k8s.io/${K8S_VERSION}/kubernetes-test-<os>-<arch>.tar.gz is the same
  # artifact kubetest2/Kubernetes CI use). Much faster than a full source clone + make.
  os="$(uname | tr '[:upper:]' '[:lower:]')"
  case "$(uname -m)" in
    x86_64) arch="amd64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) die "Unsupported architecture $(uname -m) for the kubernetes-test tarball" ;;
  esac

  KUBE_TEST_VERSION_DIR="${KUBE_TEST_TOOLS_DIR}/${K8S_VERSION}"
  E2E_TEST_BIN="${KUBE_TEST_VERSION_DIR}/kubernetes/test/bin/e2e.test"
  GINKGO_BIN="${KUBE_TEST_VERSION_DIR}/kubernetes/test/bin/ginkgo"

  if [[ ! -x "$E2E_TEST_BIN" || ! -x "$GINKGO_BIN" ]]; then
    echo "Downloading kubernetes-test tarball for ${K8S_VERSION} (${os}/${arch})"
    # Downloaded and extracted in a directory of this invocation's own, then moved into the
    # cache in one rename. Parallel workers all reach this at once on a version nobody has
    # cached yet, and downloading straight into the shared directory has them overwrite each
    # other's half-written tarball and binaries.
    mkdir -p "$KUBE_TEST_TOOLS_DIR"
    staging="$(mktemp -d "${KUBE_TEST_TOOLS_DIR}/.staging-XXXXXX")" \
      || die "Cannot create a staging directory under ${KUBE_TEST_TOOLS_DIR}"
    tarball="${staging}/kubernetes-test-${os}-${arch}.tar.gz"
    curl -Lo "$tarball" "https://dl.k8s.io/${K8S_VERSION}/kubernetes-test-${os}-${arch}.tar.gz" \
      || die "Cannot download kubernetes-test tarball for ${K8S_VERSION}. Is that a released Kubernetes version?"
    tar -xzf "$tarball" -C "$staging" kubernetes/test/bin/e2e.test kubernetes/test/bin/ginkgo \
      || die "Cannot extract e2e.test/ginkgo from kubernetes-test tarball"
    rm -f "$tarball"
    [[ -x "${staging}/kubernetes/test/bin/e2e.test" && -x "${staging}/kubernetes/test/bin/ginkgo" ]] \
      || die "e2e.test/ginkgo missing from kubernetes-test tarball after extraction"
    mkdir -p "$KUBE_TEST_VERSION_DIR"
    # Fails harmlessly if another worker got there first -- either way what is in the cache
    # afterwards is one worker's complete extraction, never a mix of several.
    mv "${staging}/kubernetes" "${KUBE_TEST_VERSION_DIR}/" 2>/dev/null
    rm -rf "$staging"
    [[ -x "$E2E_TEST_BIN" && -x "$GINKGO_BIN" ]] || die "e2e.test/ginkgo missing from ${KUBE_TEST_VERSION_DIR} after extraction"
  fi
fi

cd $TEST_RUN_DIR
cd /tmp

if [[ "$ENABLE_SNAPSHOTS" -eq 'true' && -z "$SNAPSHOT_CLASS" ]]; then
  echo "Missing volume snapshot class in test config"
fi

if [[ -f "$E2E_TEST_CONFIG_PATH" ]]; then
  rm "$E2E_TEST_CONFIG_PATH"
fi
  
cat> "$E2E_TEST_CONFIG_PATH"<<EOF
ShortName: quobyte-csi
StorageClass:
  FromFile: $STORAGE_CLASS
SnapshotClass:
  FromFile: $SNAPSHOT_CLASS
DriverInfo:
  Name: $CSI_PROVISIONER_NAME
  # Add  new capabilities from here (sample for v1.18.5)
  # https://github.com/kubernetes/kubernetes/blob/e6503f8d8f769ace2f338794c914a96fc335df0f/test/e2e/storage/testsuites/testdriver.go#L137
  Capabilities:
    persistence: true
    fsGroup: false
    exec: true
    multipods: true
    controllerExpansion: true
    nodeExpansion: false
    singleNodeVolume: true
    snapshotDataSource: $ENABLE_SNAPSHOTS
    RWX: true
EOF

echo "Running E2E with test configuration $E2E_TEST_CONFIG_PATH"
echo "E2E test results can be found at $TESTS_LOGS_PATH on test running host"

echo -e "\e[33mNote:\e[0m If tests are stuck, you need to check kind version and kind cluster\n \
         base image compatibility. See ./test_runner kindest/node:v1.... hash and kindest version\n \
         hash (kind requires exact hash specified in kind release). https://github.com/kubernetes-sigs/kind/releases"

"$GINKGO_BIN" -nodes=$NODES -focus='External.Storage.*csi.quobyte.com.*' \
-skip='\[Disruptive\]' \
"$E2E_TEST_BIN" -- -storage.testdriver="$E2E_TEST_CONFIG_PATH" -kubeconfig="${KUBECONFIG}" 2>&1 | tee "$TESTS_LOGS_PATH"
