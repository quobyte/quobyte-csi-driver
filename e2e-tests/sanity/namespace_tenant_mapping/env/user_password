# Namespace mapping on, credentials are the API user's user/password.
#
# The mapping names the tenant for a StorageClass that does not, so both cases of the test
# run: the claim without quobyteTenant lands in the tenant named after its namespace, and
# the one with it lands in the tenant it names.
#
# USE_K8S_NAMESPACE_AS_TENANT is what the Go test reads; the CSI_HELM_SET entry is what
# actually deploys the driver with the mapping. Keep the two in step.
ENABLE_ACCESS_KEY_MOUNTS=false
USE_K8S_NAMESPACE_AS_TENANT=true
CSI_HELM_SET="quobyte.useK8SNamespaceAsTenant=true"
