# Namespace mapping off, credentials are the API user's user/password.
#
# Nothing but the StorageClass can name a tenant here, so only the override case runs. A
# claim without quobyteTenant would leave the driver sending no tenant at all and the API
# resolving one from a user/password pair that belongs to no single tenant -- an outcome
# the driver does not promise either way, so the test deliberately does not assert one.
ENABLE_ACCESS_KEY_MOUNTS=false
USE_K8S_NAMESPACE_AS_TENANT=false
