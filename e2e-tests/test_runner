#!/bin/bash

PATH="$(pwd):$PATH"
CODE_BASE_DIR="$(pwd)"
KIND_DIR="$(pwd)/e2e-tests"
POD_KILLER_DIR="${KIND_DIR}/quobyte-csi-pod-killer"
CSI_CHART_TEMPLATES_DIR="${KIND_DIR}/quobyte-k8s-resources/helm/quobyte-csi/"
CLIENT_CHART_DIR="${KIND_DIR}/quobyte-k8s-resources/helm/quobyte-client/"
GO_E2E_SANITY_TESTS_DIR="${KIND_DIR}/sanity"
GO_E2E_UPSTREAM_TESTS_DIR="${KIND_DIR}/k8s-storage-tests"
UPSTREAM_E2E_SCRIPT="${KIND_DIR}/e2e"
TEST_TEMP_DIR="${KIND_DIR}/tmp"
# Everything a run produces lands here: a log per combination, a log per cluster, and the
# debug snapshot of whatever failed.
DEBUG_ROOT="${TEST_TEMP_DIR}/debug"
# Base names of the per-worker kind clusters and their kubeconfigs. The first worker gets
# these unchanged, so a sequential run is exactly what it always was -- same cluster name,
# same kubeconfig path the README tells you to export -- and further workers get a
# "-<worker>" suffix.
KIND_CLUSTER_NAME="quobyte-csi-testing"
KUBECONFIG_BASE="${TEST_TEMP_DIR}/kubeconfig-cluster"
# Do not exit on the first failure
CONTINUE_ON_FAILURE="${CONTINUE_ON_FAILURE:-true}"
# How many combinations run at once. One kind cluster cannot host two of them: the driver
# and the client are deployed under fixed helm release names, and the client is a DaemonSet
# owning a mount point per node. So a worker means a cluster of its own -- four containers
# and a driver deployment each, which is what to weigh when raising this.
PARALLEL_TESTS="${PARALLEL_TESTS:-3}"
# Seconds to wait between starting one worker and the next. Every worker begins by creating its
# kind cluster, and kubeadm gives the control plane it brings up a fixed 60s to start answering
# on :6443. Started together, N control planes (etcd + apiserver + controller-manager +
# scheduler each, plus a kubelet and containerd per node) cold-start at once and can all miss
# that deadline -- "failed to init node with kubeadm ... wait-control-plane ... context deadline
# exceeded", with every request before it logged as status="" milliseconds=0, i.e. nothing
# listening yet. Staggering keeps at most a couple of them bootstrapping at any one time. Set
# to 0 to start every worker at once, the way this script used to.
CLUSTER_START_STAGGER="${CLUSTER_START_STAGGER:-30}"
# How many times a worker tries to create its kind cluster before giving up, and how long it
# waits between tries. A cluster that loses the race above is a transient failure of the host,
# not of the driver, and without a retry it costs the whole run: the worker aborts and every
# other combination is left NOT RUN.
CLUSTER_CREATE_ATTEMPTS="${CLUSTER_CREATE_ATTEMPTS:-3}"
CLUSTER_CREATE_RETRY_DELAY="${CLUSTER_CREATE_RETRY_DELAY:-30}"
# Set to 'true' to keep every cluster a run created, the way this script always used to --
# handy to go on poking at one with kubectl afterwards. Unset, a worker deletes its cluster
# once it is done with it, so a green run of N workers does not leave N clusters behind. The
# cluster of a test that failed is never deleted; that one is the point.
KEEP_CLUSTERS="${KEEP_CLUSTERS:-false}"
# Where the quobyte-csi/quobyte-client helm charts and the images they deploy come from.
# Selected with --source (default 'build'); see print_help for the full description of each:
#   build         Build the CSI driver + pod killer from this checkout, kind-load the images,
#                 deploy the quobyte-k8s-resources submodule's charts with those images.
#   chart-images  Deploy the quobyte-k8s-resources submodule's charts as they are, i.e.
#                 whatever quobyte.dev.csiImage/podKillerImage their values.yaml already
#                 names (or a test's CSI_VALUES_FILE/CSI_HELM_SET override of them) -- pulled
#                 normally, nothing built or 'kind load'ed. This is the old USE_CHART_IMAGES=true.
#   oci-charts    Deploy quobyte-csi/quobyte-client straight from
#                 oci://quay.io/quobyte/charts/ at QUOBYTE_CSI_CHART_VERSION/
#                 QUOBYTE_CLIENT_CHART_VERSION -- neither submodule is touched and nothing is
#                 built locally.
CHART_SOURCE='build'
# Wall clock of the whole run, reported by the summary at the end. Taken from bash's own
# SECONDS counter (seconds since this shell started) rather than a timestamp, so nothing
# has to be subtracted later.
run_started_at="$SECONDS"

die() {
  echo "$*" 1>&2
  if [[ "$BASHPID" != "$$" && -d "$DEBUG_ROOT" ]]; then
    touch "${DEBUG_ROOT}/abort" 2>/dev/null
  fi
  exit 1
}

image_tag() {
  local image="$1"
  local name_part="${image##*/}"
  if [[ "$name_part" == *:* ]]; then
    echo "${name_part##*:}"
  fi
}

# The kind cluster a worker runs its combinations in, and where its kubeconfig goes. Worker
# 1 keeps the historical names (see KIND_CLUSTER_NAME above).
cluster_name_for_worker() {
  if [[ "$1" -eq 1 ]]; then
    echo "$KIND_CLUSTER_NAME"
  else
    echo "${KIND_CLUSTER_NAME}-$1"
  fi
}

kubeconfig_for_worker() {
  if [[ "$1" -eq 1 ]]; then
    echo "$KUBECONFIG_BASE"
  else
    echo "${KUBECONFIG_BASE}-$1"
  fi
}

# Renders a number of seconds the way the summary prints them: "45s", "7m03s", "1h02m03s".
format_duration() {
  local total="$1" hours minutes seconds
  hours=$((total / 3600))
  minutes=$(((total % 3600) / 60))
  seconds=$((total % 60))
  if [[ "$hours" -gt 0 ]]; then
    printf '%dh%02dm%02ds' "$hours" "$minutes" "$seconds"
  elif [[ "$minutes" -gt 0 ]]; then
    printf '%dm%02ds' "$minutes" "$seconds"
  else
    printf '%ds' "$seconds"
  fi
}

# --- The test matrix -------------------------------------------------------------
# Discovered up front, before anything is built or deployed, so that --list and a bad
# TESTS pattern are answered immediately instead of after a cluster has been created,
# and so the summary at the end of the run can also name the combinations a stopped run
# never got to. The arrays are index-aligned:
#   all_tests   "<tests_root>|<test_name>|<env_file>" -- what run_go_test_for_env needs
#   all_names   "<test_name>/<env file>"              -- how a combination is named, both
#                                                        in the summary and in TESTS
declare -a all_tests=()
declare -a all_names=()

# Collects every (test package, environment file) combination of a test set: every
# subdirectory holding an "env" directory is a test package, and every file in that
# directory is one environment to run the package against.
collect_test_set() {
  local tests_root="$1"
  local test_dir test_name env_file
  for test_dir in "${tests_root}"/*/; do
    test_name="$(basename "$test_dir")"
    if [[ ! -d "${test_dir}env" ]]; then
      continue
    fi
    for env_file in "${test_dir}env"/*; do
      [[ -f "$env_file" ]] || continue
      all_tests+=("${tests_root}|${test_name}|${env_file}")
      all_names+=("${test_name}/$(basename "$env_file")")
    done
  done
}

print_help() {
  cat <<EOF
Usage: $0 [--sanity|--upstream] [--source=build|chart-images|oci-charts] <QUOBYTE_API_URL> <QUOBYTE_REGISTRY> <QUOBYTE_CLIENT_IMAGE> [QUOBYTE_API_USER] [QUOBYTE_API_PASSWORD]
       $0 [--sanity|--upstream] --list

Spins up local kind clusters, then runs two sets of self-contained Go e2e test packages
against them. Every file in a test's "env" directory is one driver setup, and the test is
run once per file, with the Quobyte client and CSI driver redeployed for each:

  e2e-tests/sanity/    Quobyte's own driver checks.
  e2e-tests/k8s-storage-tests/  Upstream Kubernetes sig-storage suites. The test creates
                                  what the suite needs via the Quobyte API, runs it and
                                  cleans up afterwards.

See e2e-tests/README.md for details.

Arguments:
  QUOBYTE_API_URL       Quobyte API endpoint, e.g. http://host:7860 (required)
  QUOBYTE_REGISTRY      Quobyte client image registry, e.g. host:5000 (required)
  QUOBYTE_CLIENT_IMAGE  Quobyte client container image, tagged with its version, e.g.
                        quay.io/quobyte/quobyte-client:4[.8.1] (required). If this image is
                        already present in this machine's local docker images, it is
                        'kind load'ed into each cluster straight from there instead of being
                        pulled from QUOBYTE_REGISTRY; otherwise it is pulled as usual.
  QUOBYTE_API_USER      Quobyte API user (optional, default: admin)
  QUOBYTE_API_PASSWORD  Quobyte API password (optional, default: quobyte)

Options:
      --sanity          Run only the e2e-tests/sanity set.
      --upstream        Run only the e2e-tests/k8s-storage-tests set.
                        Without either, both sets run.
      --source=MODE     Where the quobyte-csi/quobyte-client charts and the images they
                        deploy come from (default: build):
                          build         Build the CSI driver + pod killer from this
                                        checkout, kind-load the images, and deploy the
                                        quobyte-k8s-resources submodule's charts with them.
                          chart-images  Deploy the quobyte-k8s-resources submodule's charts
                                        as they are -- whatever quobyte.dev.csiImage/
                                        podKillerImage their values.yaml (or a test's
                                        CSI_VALUES_FILE/CSI_HELM_SET override) already
                                        names, pulled normally. Nothing is built, and
                                        nothing is 'kind load'ed.
                          oci-charts    Deploy quobyte-csi/quobyte-client straight from
                                        oci://quay.io/quobyte/charts/ at
                                        QUOBYTE_CSI_CHART_VERSION/
                                        QUOBYTE_CLIENT_CHART_VERSION (both required in this
                                        mode). Neither submodule is touched and nothing is
                                        built locally.
  -l, --list            Print the name of every test/environment combination this run
                        would cover, then exit. These are the names the summary table
                        shows and TESTS selects on. Honors --sanity/--upstream.

Other environment variables honored:
  TESTS                 Space-separated list of the combinations to run, using the names
                        from --list; glob patterns are allowed. Naming just the test
                        package runs every environment of it ('shared_volume' and
                        'shared_volume/' both mean 'shared_volume/*'; a package whose name
                        merely starts the same way, such as shared_volume_cleanup, is not
                        included). Unset, everything runs. Checked before the cluster is
                        built, so a name that matches nothing fails immediately.
  PARALLEL_TESTS        How many combinations to run at once (default: 3). Each gets a kind
                        cluster of its own -- two cannot share one, the driver and client
                        are deployed under fixed helm release names -- so this many clusters
                        of four containers are created. Set to 1 for the sequential run,
                        which is also the only mode that streams test output to the terminal.
  KEEP_CLUSTERS         Set to 'true' to keep every cluster a run created. Unset (default),
                        a worker deletes its cluster when it is done with it -- except the
                        one holding a failed test, which is always left up for debugging.
  QUOBYTE_CSI_CHART_VERSION
                        Version of oci://quay.io/quobyte/charts/quobyte-csi to install
                        (required with --source=oci-charts, ignored otherwise), e.g. 1.8.14.
  QUOBYTE_CLIENT_CHART_VERSION
                        Version of oci://quay.io/quobyte/charts/quobyte-client to install
                        (required with --source=oci-charts, ignored otherwise), e.g. 0.3.4.
  CLUSTER_START_STAGGER Seconds between starting one worker and the next (default: 30). Each
                        starts by creating its kind cluster, and control planes bootstrapping
                        all at once can miss kubeadm's fixed 60s deadline, failing the create
                        with "wait-control-plane ... context deadline exceeded". 0 starts them
                        all at once.
  CLUSTER_CREATE_ATTEMPTS
                        How often a worker retries creating its kind cluster before giving up
                        (default: 3), waiting CLUSTER_CREATE_RETRY_DELAY seconds (default: 30)
                        in between. The nodes of a failed attempt are kept long enough to
                        export their logs to kind-csi-testing/debug/clusters/<cluster>-attempt-N/.
  SKIP_ENDPOINT_PRECHECK
                        Set to 'true' to skip checking that QUOBYTE_API_URL and QUOBYTE_REGISTRY
                        resolve and accept a connection. Unset (default), each cluster checks
                        both from one of its own nodes once its DNS is set up -- which is what
                        a pod will see -- and a cluster that cannot reach them is reported
                        there and then instead of failing test by test much later.
  CSI_PROVISIONER_NAME  CSI provisioner name (default: csi.quobyte.com)
  GO_TEST_COUNT         -count passed to 'go test' for each test package (default: 1)
  GO_TEST_TIMEOUT       -timeout passed to 'go test' (default: 20m). A test's own "env"
                        file may raise this -- the upstream suites need much longer.
  CONTINUE_ON_FAILURE   Runs the whole matrix and report every result (default).
                        Set it 'false' to stop tests at the first failing test with its
                        cluster, driver and resources left live for debugging; workers that
                        are mid-test finish it and then stop taking new work.

The output of every combination is collected under kind-csi-testing/debug/<test>/<env file>/
(run.log is the whole deploy/run/undeploy cycle, plus the debug snapshot of a failed one),
and of every cluster under kind-csi-testing/debug/clusters/. Only progress lines go to the
terminal while workers run in parallel.

Every run ends with a summary table of each test/environment combination, its result and how
long it took, followed by the wall clock of the whole run.

Examples:
  e2e-tests/test_runner http://quobyte-api.example.com:7860 registry.example.com:5000 \\
    quay.io/quobyte/quobyte-client:4[.8.1]

  # overriding the admin/quobyte user/password defaults:
  e2e-tests/test_runner http://quobyte-api.example.com:7860 registry.example.com:5000 \\
    quay.io/quobyte/quobyte-client:4[.8.1] myuser mypass

  # only the sanity tests, skipping the long upstream suites:
  e2e-tests/test_runner --sanity http://quobyte-api.example.com:7860 registry.example.com:5000 \\
    quay.io/quobyte/quobyte-client:4[.8.1]

  # re-running just one combination from the summary table:
  e2e-tests/test_runner --list
  TESTS='dynamic_provisioning/default' \\
    e2e-tests/test_runner http://quobyte-api.example.com:7860 registry.example.com:5000 \\
    quay.io/quobyte/quobyte-client:4[.8.1]

  # or every environment of one test package, by naming the package:
  TESTS='namespace_tenant_mapping' \\
    e2e-tests/test_runner http://quobyte-api.example.com:7860 registry.example.com:5000 \\
    quay.io/quobyte/quobyte-client:4[.8.1]

  # globs still work, and several patterns can be given at once:
  TESTS='external_storage/* shared_volume*/default' \\
    e2e-tests/test_runner http://quobyte-api.example.com:7860 registry.example.com:5000 \\
    quay.io/quobyte/quobyte-client:4[.8.1]

  # one at a time, in a single cluster, with the output on the terminal:
  PARALLEL_TESTS=1 \\
    e2e-tests/test_runner http://quobyte-api.example.com:7860 registry.example.com:5000 \\
    quay.io/quobyte/quobyte-client:4[.8.1]

  # deploy the quobyte-k8s-resources submodule's charts as they are, nothing built locally:
  e2e-tests/test_runner --source=chart-images http://quobyte-api.example.com:7860 \\
    registry.example.com:5000 quay.io/quobyte/quobyte-client:4[.8.1]

  # deploy released charts straight from quay.io, no submodule and nothing built locally:
  QUOBYTE_CSI_CHART_VERSION=1.8.14 QUOBYTE_CLIENT_CHART_VERSION=0.3.4 \\
    e2e-tests/test_runner --source=oci-charts http://quobyte-api.example.com:7860 \\
    registry.example.com:5000 quay.io/quobyte/quobyte-client:4[.8.1]

Requires a running docker daemon and an installed 'go'; kind/helm/kubectl are installed
automatically if missing (see e2e-tests/README.md "Requirements").
EOF
}

# --- Options ---------------------------------------------------------------------
# Consumed before the positional arguments below, in any order and any combination
# ('--sanity --list' lists just the sanity combinations).
list_tests=0
test_set='all'
while [[ "$1" == -* ]]; do
  case "$1" in
    -h|--help) print_help; exit 0 ;;
    -l|--list) list_tests=1 ;;
    --sanity)   test_set='sanity' ;;
    --upstream) test_set='upstream' ;;
    --source=*) CHART_SOURCE="${1#--source=}" ;;
    *) die "Unknown option '$1'. See '$0 --help'." ;;
  esac
  shift
done

case "$CHART_SOURCE" in
  build|chart-images|oci-charts) ;;
  *) die "--source must be one of 'build', 'chart-images' or 'oci-charts', got '${CHART_SOURCE}'." ;;
esac

# Discovery is restricted to the selected test set, so everything downstream -- the
# --list output, TESTS, the run itself and the final summary -- sees only those.
if [[ "$test_set" == 'all' ]]; then
  # Tests are run in the collected order - so run simpler sanity tests first to catch any
  # setup issues early
  collect_test_set "$GO_E2E_SANITY_TESTS_DIR"
  collect_test_set "$GO_E2E_UPSTREAM_TESTS_DIR"
elif [[ "$test_set" == 'upstream' ]]; then
  collect_test_set "$GO_E2E_UPSTREAM_TESTS_DIR"
elif [[ "$test_set" == 'sanity' ]]; then
  collect_test_set "$GO_E2E_SANITY_TESTS_DIR"
else
  die "Unknown test set ${test_set} selected"
fi

if [[ ! "$PARALLEL_TESTS" =~ ^[1-9][0-9]*$ ]]; then
  die "PARALLEL_TESTS must be a positive whole number, got '${PARALLEL_TESTS}'."
fi
if [[ ! "$CLUSTER_START_STAGGER" =~ ^[0-9]+$ ]]; then
  die "CLUSTER_START_STAGGER must be a whole number of seconds (0 to disable), got '${CLUSTER_START_STAGGER}'."
fi
if [[ ! "$CLUSTER_CREATE_ATTEMPTS" =~ ^[1-9][0-9]*$ ]]; then
  die "CLUSTER_CREATE_ATTEMPTS must be a positive whole number, got '${CLUSTER_CREATE_ATTEMPTS}'."
fi
if [[ ! "$CLUSTER_CREATE_RETRY_DELAY" =~ ^[0-9]+$ ]]; then
  die "CLUSTER_CREATE_RETRY_DELAY must be a whole number of seconds, got '${CLUSTER_CREATE_RETRY_DELAY}'."
fi

echo "Collected test set ${test_set}"

if [[ "${#all_tests[@]}" -eq 0 ]]; then
  scanned="${GO_E2E_SANITY_TESTS_DIR} or ${GO_E2E_UPSTREAM_TESTS_DIR}"
  case "$test_set" in
    sanity)   scanned="$GO_E2E_SANITY_TESTS_DIR" ;;
    upstream) scanned="$GO_E2E_UPSTREAM_TESTS_DIR" ;;
  esac
  die "No runnable test found: no test directory with an 'env' directory under ${scanned}"
fi

# Names every combination this run would cover, in run order -- the same names the
# summary prints and TESTS selects on. Needs no arguments and touches nothing.
if [[ "$list_tests" -eq 1 ]]; then
  printf '%s\n' "${all_names[@]}"
  exit 0
fi

# --- Quobyte API endpoint / registry / client image (positional args) ------------
QUOBYTE_API_URL="$1"
QUOBYTE_REGISTRY="$2"
QUOBYTE_CLIENT_IMAGE="$3"
QUOBYTE_API_USER="${4:-admin}"
QUOBYTE_API_PASSWORD="${5:-quobyte}"

if [[ -z "$QUOBYTE_API_URL" || -z "$QUOBYTE_REGISTRY" || -z "$QUOBYTE_CLIENT_IMAGE" ]]; then
  die "Usage: $0 <QUOBYTE_API_URL> <QUOBYTE_REGISTRY> <QUOBYTE_CLIENT_IMAGE> [QUOBYTE_API_USER] [QUOBYTE_API_PASSWORD]
  QUOBYTE_API_URL, QUOBYTE_REGISTRY and QUOBYTE_CLIENT_IMAGE are required.
  QUOBYTE_API_USER/QUOBYTE_API_PASSWORD are optional, defaulting to 'admin'/'quobyte' if not given.
  Example: e2e-tests/test_runner http://host:port host:port quay.io/quobyte/quobyte-client:4[.8.1]"
fi

# The quobyte-client helm chart is deployed with this image and, deduced from its tag, this
# version (see deploy_quobyte_client). A tagless reference (e.g. just "quobyte-client") has
# no version to deduce, and deploying without one is not a case worth silently allowing.
QUOBYTE_CLIENT_VERSION="$(image_tag "$QUOBYTE_CLIENT_IMAGE")"
if [[ -z "$QUOBYTE_CLIENT_VERSION" ]]; then
  die "QUOBYTE_CLIENT_IMAGE '${QUOBYTE_CLIENT_IMAGE}' has no version tag (expected e.g. \
'quay.io/quobyte/quobyte-client:4[.8.1]'); cannot deduce the client version from it."
fi

# --source=oci-charts installs oci://quay.io/quobyte/charts/quobyte-csi and
# .../quobyte-client at exactly these chart versions -- neither has a sensible default, so
# both are required up front rather than failing deep into the run's first 'helm install'.
if [[ "$CHART_SOURCE" == 'oci-charts' ]]; then
  if [[ -z "$QUOBYTE_CSI_CHART_VERSION" || -z "$QUOBYTE_CLIENT_CHART_VERSION" ]]; then
    die "--source=oci-charts requires both QUOBYTE_CSI_CHART_VERSION and \
QUOBYTE_CLIENT_CHART_VERSION to be set (the versions of oci://quay.io/quobyte/charts/quobyte-csi \
and oci://quay.io/quobyte/charts/quobyte-client to install)."
  fi
fi

# --- Test selection --------------------------------------------------------------
# TESTS picks which of the discovered combinations to run, as a space-separated list of
# summary names ("dynamic_provisioning/default"), optionally with glob patterns
# ("external_storage/*"). Unset, everything runs. Resolved here, before the cluster is
# built, so a name that matches nothing fails immediately.
#   planned_tests/planned_names  the selected subset of all_tests/all_names
#   test_results                 PASS / FAIL / SKIPPED / NOT RUN per planned combination
#   test_durations               seconds that combination took, empty until it has run
declare -a planned_tests=()
declare -a planned_names=()
declare -a test_results=()
declare -a test_durations=()
# Seconds spent building the images and the kind cluster, i.e. everything before the first
# combination starts. Stays empty if the run never gets that far, which is what tells the
# summary not to claim a setup time it does not have.
setup_seconds=''

test_selected() {
  local name="$1" pattern
  [[ -z "$TESTS" ]] && return 0
  for pattern in $TESTS; do
    # Unquoted on purpose: TESTS entries are patterns, not literal strings.
    # shellcheck disable=SC2053
    [[ "$name" == $pattern ]] && return 0
    # A pattern naming only the test package selects every environment of it, so
    # 'namespace_tenant_mapping' and 'namespace_tenant_mapping/' both mean
    # 'namespace_tenant_mapping/*' -- the common case is wanting the whole package, and
    # having to remember the glob for it is a poor default.
    #
    # The package, not a string prefix: 'shared_volume' selects the two environments of
    # shared_volume/ and leaves shared_volume_cleanup/ alone. A neighbouring package whose
    # name merely starts the same way is a different test, and quietly running it too would
    # be the worse surprise.
    # shellcheck disable=SC2053
    [[ "$name" == ${pattern%/}/* ]] && return 0
  done
  return 1
}

for i in "${!all_tests[@]}"; do
  if test_selected "${all_names[i]}"; then
    planned_tests+=("${all_tests[i]}")
    planned_names+=("${all_names[i]}")
    test_results+=('NOT RUN')
    test_durations+=('')
  fi
done

if [[ "${#planned_tests[@]}" -eq 0 ]]; then
  die "TESTS='${TESTS}' selected none of the available tests:
$(printf '  %s\n' "${all_names[@]}")
Run '$0 --list' to see them, and use those names in TESTS -- a whole name, the package part
of one to run every environment of it, or a glob pattern."
fi

if [[ -n "$TESTS" ]]; then
  echo "TESTS='${TESTS}' selected ${#planned_tests[@]} of ${#all_tests[@]} tests:"
  printf '  %s\n' "${planned_names[@]}"
fi

# Exported so every helm/kubectl call and the Go e2e tests (framework.LoadConfig reads these
# via os.Getenv) below can see them. KUBECONFIG is not among them: it names one cluster, so
# each worker exports its own (see run_worker).
export QUOBYTE_API_URL QUOBYTE_REGISTRY QUOBYTE_API_USER QUOBYTE_API_PASSWORD \
  QUOBYTE_CLIENT_IMAGE QUOBYTE_CLIENT_VERSION

# --- Quobyte endpoint parsing ----------------------------------------------------
# The endpoints themselves are checked per cluster, once its DNS has been set up -- see
# verify_endpoints_from_cluster in create_test_cluster. Checking them from this machine
# beforehand would answer the wrong question: what matters is what a pod resolves and reaches,
# and this machine can resolve names the cluster cannot and reach addresses it cannot (a
# service on 127.0.0.1 being the obvious one).

# Splits "scheme://host:port/path", "host:port" or "host" into the host and the port to test,
# printed as "<host> <port>". The port is empty when neither the value nor its scheme implies
# one, which is not an error -- it only means there is nothing to connect to.
endpoint_host_port() {
  local value="$1" scheme='' hostport host port=''
  if [[ "$value" == *://* ]]; then
    scheme="${value%%://*}"
    hostport="${value#*://}"
  else
    hostport="$value"
  fi
  hostport="${hostport%%/*}"  # drop any path
  hostport="${hostport##*@}"  # drop any user:password@
  if [[ "$hostport" == \[*\]* ]]; then
    # Bracketed IPv6 literal, where the colons are part of the address.
    host="${hostport%%\]*}"
    host="${host#\[}"
    port="${hostport##*\]}"
    port="${port#:}"
  else
    host="${hostport%%:*}"
    [[ "$hostport" == *:* ]] && port="${hostport##*:}"
  fi
  if [[ -z "$port" ]]; then
    case "$scheme" in
      http)  port=80 ;;
      https) port=443 ;;
    esac
  fi
  echo "$host $port"
}


# --- Required tools (see e2e-tests/README.md "Requirements") -------------------
# docker and go are foundational (version/daemon management is out of scope for this
# script) so we only check for them. kind/helm/kubectl are simple standalone binaries,
# so if they're missing we install them automatically.

require_docker_running() {
  if ! command -v docker &>/dev/null; then
    die "docker is required but was not found. Install Docker: https://docs.docker.com/engine/install/"
  fi
  if ! docker info &>/dev/null; then
    die "docker is installed but the docker service does not appear to be running. Start it and re-run."
  fi
}

require_go() {
  if ! command -v go &>/dev/null; then
    die "go is required but was not found in PATH. Install Go: https://go.dev/doc/install"
  fi
}

install_kind_if_missing() {
  if command -v kind &>/dev/null; then
    return
  fi
  # kind may already be installed under $(go env GOPATH)/bin, just not on PATH yet.
  export PATH="$(go env GOPATH)/bin:${PATH}"
  if command -v kind &>/dev/null; then
    return
  fi
  echo "kind not found, installing via 'go install sigs.k8s.io/kind@latest' ..."
  go install sigs.k8s.io/kind@latest || die "Failed installing kind"
  command -v kind &>/dev/null || die "kind was installed but is not on PATH (expected $(go env GOPATH)/bin)"
  echo "Installed kind: $(kind version)"
}

install_helm_if_missing() {
  if command -v helm &>/dev/null; then
    return
  fi
  echo "helm not found, installing via the official get-helm-3 script ..."
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash \
    || die "Failed installing helm"
  command -v helm &>/dev/null || die "helm installation did not succeed"
  echo "Installed helm: $(helm version --short)"
}

install_kubectl_if_missing() {
  if command -v kubectl &>/dev/null; then
    return
  fi
  echo "kubectl not found, installing latest stable release ..."
  local os arch kubectl_version tmp
  os="$(uname | tr '[:upper:]' '[:lower:]')"
  case "$(uname -m)" in
    x86_64) arch="amd64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) die "Unsupported architecture $(uname -m) for automatic kubectl install. Install kubectl manually: https://kubernetes.io/docs/tasks/tools/#kubectl" ;;
  esac
  kubectl_version="$(curl -Ls https://dl.k8s.io/release/stable.txt)" || die "Failed determining latest kubectl version"
  tmp="$(mktemp)"
  curl -Lo "$tmp" "https://dl.k8s.io/release/${kubectl_version}/bin/${os}/${arch}/kubectl" \
    || die "Failed downloading kubectl"
  chmod +x "$tmp"
  sudo install -m 0755 "$tmp" /usr/local/bin/kubectl || die "Failed installing kubectl to /usr/local/bin/kubectl"
  rm -f "$tmp"
  command -v kubectl &>/dev/null || die "kubectl was installed but is not on PATH"
  echo "Installed kubectl: $kubectl_version"
}

