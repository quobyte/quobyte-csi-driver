#!/bin/bash

PATH="$(pwd):$PATH"
CODE_BASE_DIR="$(pwd)"
KIND_DIR="$(pwd)/kind-tests"
POD_KILLER_DIR="${KIND_DIR}/quobyte-csi-pod-killer"
CSI_CHART_TEMPLATES_DIR="${KIND_DIR}/quobyte-k8s-resources/helm/quobyte-csi/"
CLIENT_CHART_DIR="${KIND_DIR}/quobyte-k8s-resources/helm/quobyte-client/"
GO_E2E_TESTS_DIR="${KIND_DIR}/e2e-tests"
KIND_CLUSTER_NAME="quobyte-csi-testing"
TEST_CLUSTER_DIR="${KIND_DIR}/kind-csi-testing"
KUBECONFIG='/tmp/quobyte-k8s-config'

die() { echo "$*" 1>&2 ; exit 1; }

# --- Quobyte API endpoint / registry (positional args) ---------------------------
QUOBYTE_API_URL="$1"
QUOBYTE_REGISTRY="$2"
QUOBYTE_API_USER="${3:-admin}"
QUOBYTE_API_PASSWORD="${4:-quobyte}"

if [[ -z "$QUOBYTE_API_URL" || -z "$QUOBYTE_REGISTRY" ]]; then
  die "Usage: $0 <QUOBYTE_API_URL> <QUOBYTE_REGISTRY> [QUOBYTE_API_USER] [QUOBYTE_API_PASSWORD]
  QUOBYTE_API_URL and QUOBYTE_REGISTRY are required. QUOBYTE_API_USER/QUOBYTE_API_PASSWORD
  are optional, defaulting to 'admin'/'quobyte' if not given.
  Example: kind-tests/run_test http://host:port host:port"
fi

# Exported so every helm/kubectl call and the Go e2e tests (framework.LoadConfig reads
# these via os.Getenv) below can see them, the same way KUBECONFIG is exported.
export QUOBYTE_API_URL QUOBYTE_REGISTRY QUOBYTE_API_USER QUOBYTE_API_PASSWORD

# --- Required tools (see kind-tests/README.md "Requirements") -------------------
# docker and go are foundational (version/daemon management is out of scope for this
# script) so we only check for them. kind/helm/kubectl are simple standalone binaries,
# so if they're missing we install them automatically.

require_docker_running() {
  if ! command -v docker &>/dev/null; then
    die "docker is required but was not found. Install Docker: https://docs.docker.com/engine/install/"
  fi
  if ! docker info &>/dev/null; then
    die "docker is installed but the docker service does not appear to be running. Start it and re-run."
  fi
}

require_go() {
  if ! command -v go &>/dev/null; then
    die "go is required but was not found in PATH. Install Go: https://go.dev/doc/install"
  fi
}

install_kind_if_missing() {
  if command -v kind &>/dev/null; then
    return
  fi
  # kind may already be installed under $(go env GOPATH)/bin, just not on PATH yet.
  export PATH="$(go env GOPATH)/bin:${PATH}"
  if command -v kind &>/dev/null; then
    return
  fi
  echo "kind not found, installing via 'go install sigs.k8s.io/kind@latest' ..."
  go install sigs.k8s.io/kind@latest || die "Failed installing kind"
  command -v kind &>/dev/null || die "kind was installed but is not on PATH (expected $(go env GOPATH)/bin)"
  echo "Installed kind: $(kind version)"
}

install_helm_if_missing() {
  if command -v helm &>/dev/null; then
    return
  fi
  echo "helm not found, installing via the official get-helm-3 script ..."
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash \
    || die "Failed installing helm"
  command -v helm &>/dev/null || die "helm installation did not succeed"
  echo "Installed helm: $(helm version --short)"
}

install_kubectl_if_missing() {
  if command -v kubectl &>/dev/null; then
    return
  fi
  echo "kubectl not found, installing latest stable release ..."
  local os arch kubectl_version tmp
  os="$(uname | tr '[:upper:]' '[:lower:]')"
  case "$(uname -m)" in
    x86_64) arch="amd64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) die "Unsupported architecture $(uname -m) for automatic kubectl install. Install kubectl manually: https://kubernetes.io/docs/tasks/tools/#kubectl" ;;
  esac
  kubectl_version="$(curl -Ls https://dl.k8s.io/release/stable.txt)" || die "Failed determining latest kubectl version"
  tmp="$(mktemp)"
  curl -Lo "$tmp" "https://dl.k8s.io/release/${kubectl_version}/bin/${os}/${arch}/kubectl" \
    || die "Failed downloading kubectl"
  chmod +x "$tmp"
  sudo install -m 0755 "$tmp" /usr/local/bin/kubectl || die "Failed installing kubectl to /usr/local/bin/kubectl"
  rm -f "$tmp"
  command -v kubectl &>/dev/null || die "kubectl was installed but is not on PATH"
  echo "Installed kubectl: $kubectl_version"
}

echo "*** Checking required tools (docker, go, kind, helm, kubectl) ***"
require_docker_running
require_go
install_kind_if_missing
install_helm_if_missing
install_kubectl_if_missing

MOUNT_WITH_ACCESS_KEYS=${MOUNT_WITH_ACCESS_KEYS:-n}
# Same physical driver for every test directory in a run, so this is script-level config
# rather than something duplicated into each test's "env" file.
export CSI_PROVISIONER_NAME="${CSI_PROVISIONER_NAME:-csi.quobyte.com}"
CONTAINER_URL_BASE="dummy.quobyte.com/quobyte-csi-driver"
# do not tag version as latest - that would trigger pull always from registry
CSI_DRIVER_VERSION="$(git rev-parse --short HEAD)"
# dummy.quobyte.com is not a docker registry. We buid docker image locally
# and make it available to kind nodes via 'kind load docker-image'
CSI_DRIVER_IMAGE="${CONTAINER_URL_BASE}:${CSI_DRIVER_VERSION}"

if [ ! -z "$(git status --porcelain)" ]; then
  echo 'Requires clean directory (no stage/unstaged/untracked files) in repo'
  exit 1
fi

if [ ! -d "${POD_KILLER_DIR}" ]; then
  die "Pod killer code base does not exists in the path ${POD_KILLER_DIR}"
fi

echo "*** Building pod killer ***"
cd ${POD_KILLER_DIR}
POD_KILLER_VERSION="$(git rev-parse --short HEAD)"
POD_KILLER_CONTAINER_URL_BASE="dummy.quobyte.com/pod-killer"
CONTAINER_URL_BASE="${POD_KILLER_CONTAINER_URL_BASE}" \
 LOCAL_IMAGE='true' ${POD_KILLER_DIR}/build container ${POD_KILLER_VERSION}
pod_killer_container_build_status=$?

if [[ "${pod_killer_container_build_status}" -ne 0 ]]; then
  die "Failed building pod killer container"
else
  POD_KILLER_IMAGE=${POD_KILLER_CONTAINER_URL_BASE}:${POD_KILLER_VERSION}
  echo "Successfully built pod killer image $POD_KILLER_IMAGE"
fi

cd $CODE_BASE_DIR
if [[ -f "$KUBECONFIG" ]]; then
  rm "$KUBECONFIG"
fi

# set kubeconfig so that kubectl in this context can with the kind cluster configuration
export KUBECONFIG="${KUBECONFIG}"

tee -a "$KUBECONFIG" <<END
apiVersion: v1
kind: Config
preferences: {}
END

rm -rf "${TEST_CLUSTER_DIR}"

mkdir -p "${TEST_CLUSTER_DIR}"

echo "Running script from $(pwd)"

echo "Creating kind k8s cluster Dockerfile * * * * * * * * *  * * * * * * * * * * * * * * * * *"
echo ""
echo ""

# https://github.com/kubernetes-sigs/kind/releases
# Install the latest kind binary (download and add executable
# to your PATH) from the releases on testing host
# and update the kindest/node: image
tee -a "${TEST_CLUSTER_DIR}"/Dockerfile <<END
FROM kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
RUN apt-get -y update 
RUN apt-get -y install wget && apt-get install -y git && apt install -y nano dnsutils
RUN groupadd admin && useradd admin -g admin
END

echo "Building new image using the above Dockerfile. On the local machine: * * *"
# Change `v0` appropriately to whatever version is needed.
docker build -t 'quobyte/kind-node-testing:v0' -f "${TEST_CLUSTER_DIR}"/Dockerfile .

docker image ls | grep 'quobyte/kind-node-testing:v0'

echo "Use the newly created image in the kind cluster configuration: * * * * * * * * *"
tee -a "${TEST_CLUSTER_DIR}"/kind-config-testing.yaml <<END
kind: Cluster
name: ${KIND_CLUSTER_NAME}
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  image: quobyte/kind-node-testing:v0
- role: worker
  image: quobyte/kind-node-testing:v0
- role: worker
  image: quobyte/kind-node-testing:v0
- role: worker
  image: quobyte/kind-node-testing:v0
END

echo  "Creating cluster with kind: * * * * * * * * * * * * * * * * * * * * * * *"
kind create cluster --config="${TEST_CLUSTER_DIR}"/kind-config-testing.yaml --kubeconfig ${KUBECONFIG}

verify_all_nodes_ready() {
  local -n result=$1
  has_not_ready_nodes="0"
  let current_time=0
  while [[ $has_not_ready_nodes -eq 0 && $current_time -le 300 ]]; do
    kubectl get nodes  | awk 'NR>1{print $2}' | grep -q 'NotReady'
    has_not_ready_nodes="$?"
    if [[ "$has_not_ready_nodes" -eq 0 ]]; then
      echo -e "\e[33mK8S node(s) is not ready yet, will check again in 10s\e[0m"
      sleep 10s
      current_time=$(($current_time + 10))
    fi
  done
  result=$has_not_ready_nodes
}

verify_all_nodes_ready has_not_ready_nodes
if [[ "$has_not_ready_nodes" -eq 0 ]]; then
  echo ""
  kubectl get nodes | grep -q "NotReady" | awk 'NR>1{print $1}' \
  | xargs -I {} sh -c "echo "Restarting the node container {}"; sudo docker restart {}"
fi
verify_all_nodes_ready has_not_ready_nodes
if [[ "$has_not_ready_nodes" -eq 0 ]]; then
  echo "K8S nodes are not ready after 10 minutes (Restarting also not fixed the nodes ready issue). \
       Cannot continue testing cluster setup. Please fix the node not ready issue."
fi
# Wait until nodes are ready for DNS entries to be added - adding DNS entries before nodes are ready
# makes nodes hang in NotReady
dns_ips="$(kubectl get services -n kube-system | grep 'kube-dns' | awk '{print $3}')"
if [[ -z "$dns_ips" ]]; then
  echo "Error: could not retrieve required kube-dns IP"
  exit 1
fi
if ! [[ "$dns_ips" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Error: Invalid kube-dns IP $dns_ips"
  exit 1
fi

# Add host dns entries, so that we can resolve all the names (dependent container urls, Quobyte
# api/registry etc)
for host_dns_ip in $(grep nameserver /etc/resolv.conf | awk '{print $2}'); do
   dns_ips="$dns_ips $host_dns_ip"
done

# Requires for Quobyte pod killer components - cache is run as a service and mount monitor
# uses service url to communicate with the cache. Without kube-dns mapped, mount monitor cannot
# resolve the service url
echo "Mapping k8s kube-dns resolver into k8s nodes * * * * * * * * *"
for node in $(kubectl get nodes --no-headers | grep 'worker' | awk '{print $1}'); do
  echo "Mapping k8s kube-dns resolver into $node"
  # Nullify current configuration -- ATM, kind configures dns is configured with the default
  # gateway of the virtual network
  sudo docker exec -it $node sh -c "cat /dev/null > /etc/resolv.conf"
  # Next couple of lines are not intended on purpose - otherwise command does not work as
  # -c interprets text verbatim
  sudo docker exec -it $node sh -c "cat > /etc/resolv.conf <<END
search default svc.cluster.local cluster.local
END"
for dns_ip in $dns_ips; do
sudo docker exec -it $node sh -c "cat >> /etc/resolv.conf <<END
nameserver $dns_ip
END"
done
 sudo docker exec -it $node sh -c "cat >> /etc/resolv.conf <<END
options timeout:1 ndots:0
END"
  echo "Configured worker node $node with DNS entries as following:"
  sudo docker exec -it quobyte-csi-testing-worker sh -c "cat /etc/resolv.conf"
  echo ""
done

echo  "Labeling Kubernetes nodes for Quobyte client installation * * * * * * * * * * * * * * *"
for node in $(kubectl get nodes --no-headers | awk '{print $1}'); do
  kubectl label nodes $node quobyte_client="true"
done

echo "Building local csi driver image"
CONTAINER_URL_BASE=${CONTAINER_URL_BASE} LOCAL_IMAGE='true' \
 DISABLE_VERSION_VALIDATION='true' ${CODE_BASE_DIR}/src/build.sh \
 container ${CSI_DRIVER_VERSION}

if [[ "$?" -ne 0 ]]; then
  echo "Failed to create local image (compile or image build failed!)"
  exit 1
fi
kind load docker-image ${CSI_DRIVER_IMAGE} --name ${KIND_CLUSTER_NAME}
kind load docker-image ${POD_KILLER_IMAGE} --name ${KIND_CLUSTER_NAME}

echo "creating and setting default namespace to quobyte * * * * * * * * * * * *" 
#to retrieve instances from all namespaces use '-A' argument
kubectl create ns quobyte
kubectl config get-contexts
kubectl get namespaces --context kind-quobyte-csi-testing
kubectl config use-context kind-quobyte-csi-testing
kubectl config set-context --current --namespace=quobyte

echo "To access the test cluster you should export KUBECONFIG=$KUBECONFIG env varialbe"

if [[ ! -d "$GO_E2E_TESTS_DIR" ]]; then
  die "No Go e2e tests found: ${GO_E2E_TESTS_DIR} does not exist"
fi

verify_namespace_has_no_crashing_pods() {
  namespace=''
  if [[ -z "$1" ]]; then
    echo 'No namespace provided for pod health check. Defaulting to --all-namepaces namespace'
    namespace="--all-namespaces"
  else
    namespace="$1"
  fi
  has_crashing_pods=0
  count=1
  while [[ $has_crashing_pods -eq 0 && count -le 10 ]]; do
    kubectl get po -n $namespace | awk 'NR>1{print $3}' | grep -iv 'running'
    # inverted match - result is 0 if at least one pod is !running, 1 - if all are running
    has_crashing_pods="$?"
    let count++
    if [[ $has_crashing_pods -eq 0 ]]; then
      sleep 1m
      echo "Waiting for all pods in namespace $namespace to be in Running state. Time elapsed $count minutes"
    fi
  done
  if [[ $has_crashing_pods -eq 0 ]]; then
    echo "Some of the pods in namespace $namespace are not in Running state after $count minutes."
    echo "Get pods in namespace $namespace, describe crashing pod(s) to find the crash reason and retyin fixing it."
    echo "This indicates a problem with the driver setup, therefore exiting with error code 1"
    exit 1
  fi
}

function check_snapshots_resources_exists() {
  if [[ ! -f "${CSI_CHART_TEMPLATES_DIR}templates/csi-driver.yaml" ]]; then
    echo "ERROR: quobyte-csi helm chart not found at ${CSI_CHART_TEMPLATES_DIR} (missing templates/csi-driver.yaml). Is the quobyte-k8s-resources submodule checked out?"
    exit 1
  fi
  if [[ ! -f "${CSI_CHART_TEMPLATES_DIR}k8s-snapshot-crd.yaml" ]]; then
    echo "ERROR: k8s snapshot CRD definitions not found in ${CSI_CHART_TEMPLATES_DIR}k8s-snapshot-crd.yaml"
    exit 1
  fi
  if [[ ! -f "${CSI_CHART_TEMPLATES_DIR}k8s-snapshot-controller.yaml" ]]; then
    echo "ERROR: k8s snapshot controller definition not found in ${CSI_CHART_TEMPLATES_DIR}k8s-snapshot-controller.yaml"
    exit 1
  fi
}

# Installs the external-snapshotter CRDs/controller if the given values.yaml enables
# snapshots. Idempotent across multiple test directories (only installs once).
snapshot_crds_installed=0
deploy_snapshot_resources_if_needed() {
  local values_file="$1"
  if ! grep -E "enableSnapshots:.*true" "$values_file" &> /dev/null; then
    return
  fi
  if [[ "$snapshot_crds_installed" -eq 1 ]]; then
    return
  fi
  check_snapshots_resources_exists
  kubectl create -f "${CSI_CHART_TEMPLATES_DIR}k8s-snapshot-crd.yaml"
  sleep 10s
  kubectl create -f "${CSI_CHART_TEMPLATES_DIR}k8s-snapshot-controller.yaml"
  snapshot_crds_installed=1
}

# Deploys quobyte-client using QUOBYTE_REGISTRY (a required script argument, see top of
# file) and ENABLE_ACCESS_KEY_MOUNTS (set by the per-test "env" file sourced by the caller).
deploy_quobyte_client() {
  echo "Deploying Quobyte client with helm chart ${CLIENT_CHART_DIR} (registry: $QUOBYTE_REGISTRY, enableAccessKeys: $ENABLE_ACCESS_KEY_MOUNTS)"
  helm install quobyte-client "${CLIENT_CHART_DIR}" --namespace kube-system \
   --set quobyte.registry="$QUOBYTE_REGISTRY" \
   --set-string quobyte.enableAccessKeys="$ENABLE_ACCESS_KEY_MOUNTS" \
   --set-string nodeSelector.quobyte_client="true" \
   || die 'Failed installing quobyte-client helm chart'
  sleep 30s
}

# Deploys quobyte-csi-driver from the given values.yaml, using CSI_PROVISIONER_NAME and
# QUOBYTE_API_URL (both script-level config, see top of file).
deploy_csi_driver() {
  local values_file="$1"
  if [[ ! -f "$values_file" ]]; then
    die "$values_file not found. Cannot setup Quobyte CSI Driver."
  fi
  echo ""
  echo "Deploying CSI Driver with $values_file with overrides \
        quobyte.dev.csiProvisionerVersion=$CSI_DRIVER_VERSION \
        quobyte.dev.csiImage=$CSI_DRIVER_IMAGE \
        quobyte.dev.podKillerImage=$POD_KILLER_IMAGE \
        quobyte.csiProvisionerName=$CSI_PROVISIONER_NAME \
        quobyte.apiURL=$QUOBYTE_API_URL"
  helm install quobyte-csi-driver ${CSI_CHART_TEMPLATES_DIR} -f "$values_file" \
   --set quobyte.dev.csiProvisionerVersion="$CSI_DRIVER_VERSION" \
   --set quobyte.dev.csiImage="$CSI_DRIVER_IMAGE" \
   --set quobyte.dev.podKillerImage="$POD_KILLER_IMAGE" \
   --set quobyte.csiProvisionerName="$CSI_PROVISIONER_NAME" \
   --set quobyte.apiURL="$QUOBYTE_API_URL" \
   || die 'Failed installing quobyte-csi-driver helm chart'

  sleep 1m
  verify_namespace_has_no_crashing_pods

  echo "List all pods"
  kubectl get po --all-namespaces
}

undeploy_csi_driver_and_client() {
  helm uninstall quobyte-csi-driver -n quobyte || true
  helm uninstall quobyte-client -n kube-system || true
}

# Dumps cluster/driver/client state into debug_dir for a failed test, before
# undeploy_csi_driver_and_client tears anything down. Best-effort: individual
# collection steps are allowed to fail without aborting the dump.
dump_debug_info() {
  local test_name="$1"
  local debug_dir="$2"
  local test_namespace="$3"
  echo "Dumping debug information for failed test '$test_name' to $debug_dir"

  {
    echo "test_dir=${test_dir}"
    echo "values_file=${values_file}"
    echo "QUOBYTE_API_URL=${QUOBYTE_API_URL}"
    echo "QUOBYTE_TENANT=${QUOBYTE_TENANT}"
    echo "QUOBYTE_REGISTRY=${QUOBYTE_REGISTRY}"
    echo "ENABLE_ACCESS_KEY_MOUNTS=${ENABLE_ACCESS_KEY_MOUNTS}"
    echo "CSI_PROVISIONER_NAME=${CSI_PROVISIONER_NAME}"
  } > "${debug_dir}/test-env.txt"

  kubectl get pods --all-namespaces -o wide > "${debug_dir}/pods.txt" 2>&1
  kubectl describe pods --all-namespaces > "${debug_dir}/pods-describe.txt" 2>&1
  kubectl get events --all-namespaces --sort-by='.lastTimestamp' > "${debug_dir}/events.txt" 2>&1
  kubectl get pvc,pv,storageclass,secret --all-namespaces -o wide > "${debug_dir}/storage.txt" 2>&1
  kubectl get csidriver -o yaml > "${debug_dir}/csidriver.yaml" 2>&1
  helm list --all-namespaces > "${debug_dir}/helm-releases.txt" 2>&1

  # The Go e2e test's own PVC/Pod/Secret live in test_namespace (NAMESPACE passed to
  # go test, randomized per test run). Events/describe/logs scoped to just that
  # namespace are the most directly relevant signal for why the test pod itself
  # failed to schedule, mount, or run -- pulled out separately from the
  # all-namespaces dump above since that gets noisy with kube-system/kind-system
  # events.
  echo "Collecting events/pod state for the test namespace $test_namespace (where the e2e test pod runs)"
  kubectl get events -n "$test_namespace" --sort-by='.lastTimestamp' > "${debug_dir}/events-test-namespace.txt" 2>&1
  kubectl -n "$test_namespace" describe pods > "${debug_dir}/pods-describe-test-namespace.txt" 2>&1
  local test_pod
  for test_pod in $(kubectl -n "$test_namespace" get po -o name 2>/dev/null); do
    kubectl -n "$test_namespace" logs "${test_pod#pod/}" --all-containers > "${debug_dir}/${test_pod#pod/}.log" 2>&1
  done

  echo "Collecting Quobyte CSI driver logs via log_collector.sh"
  ( cd "$debug_dir" && DRIVER_NAMESPACE="quobyte" bash "${CSI_CHART_TEMPLATES_DIR}log_collector.sh" ) \
    || echo "log_collector.sh failed, continuing"

  echo "Collecting Quobyte client logs"
  local client_pod
  for client_pod in $(kubectl -n kube-system get po -l role=client -o name 2>/dev/null); do
    kubectl -n kube-system logs "${client_pod#pod/}" > "${debug_dir}/${client_pod#pod/}.log" 2>&1
  done

  echo "Debug information for '$test_name' saved to $debug_dir"
}

# If a StorageClass artifact was dumped into artifacts_dir by the Go test (see
# framework.DumpStorageClassYAML in kind-tests/e2e-tests), runs the upstream Kubernetes
# e2e (sig-storage "external storage") suite via kind-tests/e2e against the exact same
# quobyte-csi-driver/quobyte-client deployment the Go test in $test_dir just passed
# against. The Go test's own successful cleanup has already deleted its Secret and
# StorageClass from the cluster by the time this runs, so the dumped copies are
# re-applied here, used for the upstream suite, then deleted again afterward. Returns
# non-zero on failure; caller decides what to do (the debug snapshot/cleanup-skip
# behavior lives in the caller, same as for the Go test, so both failure paths look the
# same to the user).
run_upstream_k8s_e2e_if_configured() {
  local test_name="$1"
  local artifacts_dir="$2"
  local debug_dir="$3"

  local storage_class_file
  storage_class_file="$(ls "${artifacts_dir}"/*-storageclass.yaml 2>/dev/null | head -n1)"
  if [[ -z "$storage_class_file" ]]; then
    echo "No StorageClass artifact found in $artifacts_dir. Skipping upstream k8s e2e for '$test_name'."
    return 0
  fi

  echo ""
  echo "Running upstream Kubernetes e2e (external-storage) suite for '$test_name' against the same setup"

  local secret_file
  secret_file="$(ls "${artifacts_dir}"/*-secret.yaml 2>/dev/null | head -n1)"
  if [[ -n "$secret_file" ]]; then
    kubectl apply -f "$secret_file" || die "Failed applying $secret_file"
  fi
  kubectl apply -f "$storage_class_file" || die "Failed applying $storage_class_file"

  local snapshot_class_file="${artifacts_dir}/k8s_volume-snapshot-class.yaml"
  local enable_snapshots='false'

  STORAGE_CLASS="$storage_class_file" KUBECONFIG="$KUBECONFIG" \
   SNAPSHOT_CLASS="$snapshot_class_file" \
   CSI_PROVISIONER_NAME="$CSI_PROVISIONER_NAME" ENABLE_SNAPSHOTS="$enable_snapshots" \
   kind-tests/e2e 2>&1 | tee "${debug_dir}/k8s-e2e-output.log"
  local status=${PIPESTATUS[0]}

  kubectl delete -f "$storage_class_file" --ignore-not-found
  if [[ -n "$secret_file" ]]; then
    kubectl delete -f "$secret_file" --ignore-not-found
  fi

  return "$status"
}

echo ""
# Each subdirectory of kind-tests/e2e-tests is a self-contained Go test package with
# its own "env" file (ENABLE_ACCESS_KEY_MOUNTS and any test-specific overrides like
# QUOBYTE_TENANT) and its own "values.yaml" for the CSI driver chart. The Quobyte API
# endpoint/client registry (QUOBYTE_API_URL/USER/PASSWORD, QUOBYTE_REGISTRY) and
# CSI_PROVISIONER_NAME are script-level config (see top of file), not part of any
# per-test env file -- the same physical endpoints/driver apply to every test directory
# in a run.
# For each test directory found: deploy its environment (export the env file's
# variables), deploy quobyte-client and quobyte-csi-driver using that environment and
# values.yaml, run just that package's tests, then tear down the driver/client and
# remove the environment (unset those variables) before moving on to the next test.
# On failure, everything (cluster, driver, client, and the test's own resources) is
# left running for live debugging instead of continuing to the next test -- see
# cleanupUnlessFailed in the Go tests, which skips deleting its own resources when
# the test failed.
go_e2e_tests_found=0

for test_dir in "${GO_E2E_TESTS_DIR}"/*/; do
  test_name="$(basename "$test_dir")"
  env_file="${test_dir}env"
  values_file="${CSI_CHART_TEMPLATES_DIR}values.yaml"
  if [[ ! -f "$env_file" ]]; then
    continue
  fi
  go_e2e_tests_found=1

  echo "Deploying environment for Go e2e test '$test_name' from $env_file"
  set -a
  source "$env_file"
  set +a

  deploy_snapshot_resources_if_needed "$values_file"
  deploy_quobyte_client
  deploy_csi_driver "$values_file"

  # Randomize the namespace the test's own Secret/StorageClass/PVC/Pod live in
  # (separate from the driver's fixed "quobyte" operating namespace set up above)
  # so each test run gets isolated, uniquely-named resources.
  test_suffix="$(date +%s)-${RANDOM}"
  test_namespace="quobyte-e2e-${test_suffix}"
  storage_class_name="quobyte-sc-${test_suffix}"
  # Generate a unique tenant name per run, unless the test's own "env" file already
  # pins one (e.g. because it must run against a pre-existing tenant). Only the name
  # is generated here -- actually creating the tenant + user and granting access to it
  # is not done yet (TODO(venkat)), so this only helps once that exists, or for tests
  # that create/expect their own tenant out of band.
  quobyte_tenant="${QUOBYTE_TENANT:-quobyte-tenant-${test_suffix}}"
  echo "Creating test namespace $test_namespace"
  kubectl create ns "$test_namespace" || die "Failed creating namespace $test_namespace"

  echo "Running Go e2e test '$test_name'"
  debug_dir="${TEST_CLUSTER_DIR}/debug/${test_name}"
  artifacts_dir="${debug_dir}/artifacts"
  mkdir -p "$debug_dir" "$artifacts_dir"
  ( cd "${GO_E2E_TESTS_DIR}" && KUBECONFIG="$KUBECONFIG" NAMESPACE="$test_namespace" \
    STORAGE_CLASS_NAME="$storage_class_name" \
    QUOBYTE_TENANT="$quobyte_tenant" \
    ARTIFACTS_DIR="$artifacts_dir" \
    go test "./${test_name}/..." -v -timeout 20m -count="${GO_TEST_COUNT:-1}" ) 2>&1 | tee "${debug_dir}/go-test-output.log"
  test_status=${PIPESTATUS[0]}
  if [[ "$test_status" -ne 0 ]]; then
    dump_debug_info "$test_name" "$debug_dir" "$test_namespace"
    echo ""
    echo "Go e2e test '$test_name' FAILED."
    echo "The test skips its own cleanup on failure, so the cluster, quobyte-csi-driver,"
    echo "quobyte-client, and this test's Secret/StorageClass/PVC/Pod are all still"
    echo "running -- inspect them live, e.g.:"
    echo ""
    echo "  export KUBECONFIG=$KUBECONFIG"
    echo "  kubectl -n $test_namespace get pods,pvc,secret,storageclass"
    echo ""
    echo "A best-effort debug snapshot (pod/events/driver+client logs) was also saved to"
    echo "$debug_dir"
    echo ""
    echo "Run 'kind-tests/cleanup' when done to tear everything down."
    die "Stopping after first failed Go e2e test ('$test_name')."
  fi
  run_upstream_k8s_e2e_if_configured "$test_name" "$artifacts_dir" "$debug_dir"

  echo "Removing quobyte-csi-driver/quobyte-client deployed for '$test_name'"
  undeploy_csi_driver_and_client

  echo "Removing test namespace $test_namespace"
  kubectl delete ns "$test_namespace" --ignore-not-found

  echo "Removing environment for Go e2e test '$test_name'"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    unset "${line%%=*}"
  done < "$env_file"
done

if [[ "$go_e2e_tests_found" -eq 0 ]]; then
  die "No test directory with an 'env' file was found under ${GO_E2E_TESTS_DIR}"
fi
